    "Show memories in sections by category. Turn this off for a single list, most recent first." : {
      "comment" : "Explains the Group by Category setting. 'Memories' are the saved entries.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رتّب عناصرك حسب الفئة. أوقف هذا الخيار لعرضها في قائمة واحدة، من الأحدث إلى الأقدم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordne deine Einträge nach Kategorien. Schaltest du das aus, siehst du eine Liste mit den neuesten Einträgen zuerst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep memories organized by category. Turn this off to see one list, with the newest first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organiza tus entradas por categoría. Desactiva esta opción para ver una sola lista, con las más recientes primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organisez vos entrées par catégorie. Désactivez cette option pour afficher une seule liste, de la plus récente à la plus ancienne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एंट्री को श्रेणी के हिसाब से रखें। इसे बंद करने पर सभी एंट्री एक सूची में दिखेंगी, सबसे नई सबसे ऊपर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizza le voci per categoria. Disattiva questa opzione per vedere un unico elenco, con le più recenti in cima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目をカテゴリごとにまとめます。オフにすると、新しい順にひとつのリストで表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목을 카테고리별로 모아 보여 줘요. 끄면 최신 항목부터 하나의 목록으로 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orden je items op categorie. Zet dit uit voor één lijst met de nieuwste items bovenaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize suas entradas por categoria. Desative para ver uma única lista, com as mais recentes primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распределяйте записи по категориям. Отключите, чтобы видеть их одним списком, начиная с самых новых."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlarını kategorilere ayır. Kapatırsan tüm kayıtları en yeniden eskiye tek bir listede görürsün."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按类别整理条目。关闭后，所有条目将按从新到旧的顺序显示在同一个列表中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依類別整理項目。關閉後，所有項目會由新到舊顯示在同一份列表中。"
          }
        }
      }
    },
