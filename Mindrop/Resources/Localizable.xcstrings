          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи удаляются навсегда через 30 дней после удаления на всех ваших устройствах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
