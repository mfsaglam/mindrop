        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह याद आपके सभी डिवाइस से डिलीट हो जाएगी। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
