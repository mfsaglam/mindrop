    "Show memories in sections by category. Turn this off for a single list, most recent first." : {
      "comment" : "Explains the Group by Category setting. 'Memories' are the saved entries.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض السجلات في أقسام حسب الفئة. أوقف هذا الخيار لعرض قائمة واحدة، الأحدث أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge nach Kategorie in Abschnitten anzeigen. Ausschalten für eine einzige Liste, neueste zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra las entradas en secciones por categoría. Desactívalo para ver una sola lista, con lo más reciente primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les entrées en sections par catégorie. Désactivez pour une liste unique, les plus récentes en premier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रविष्टियों को श्रेणी के अनुसार अनुभागों में दिखाएँ। एक ही सूची के लिए इसे बंद करें, सबसे नई पहले।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le voci in sezioni per categoria. Disattiva per un unico elenco, dal più recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目をカテゴリ別のセクションで表示します。オフにすると、新しい順の1つのリストになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목을 카테고리별 섹션으로 표시합니다. 끄면 최신 항목부터 하나의 목록으로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
