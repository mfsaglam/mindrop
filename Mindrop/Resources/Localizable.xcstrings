    "A deleted memory waits here, so a mistake can be undone." : {
      "comment" : "Under the title of the empty Recently Deleted.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذفت شيئًا بالخطأ؟ يمكنك استعادته من هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versehentlich gelöscht? Hier kannst du deine Einträge wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted something by mistake? You can restore it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has borrado algo por error? Puedes recuperarlo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une suppression par erreur ? Vous pouvez récupérer vos entrées ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गलती से कुछ हटा दिया? उसे यहाँ से वापस ला सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai eliminato qualcosa per sbaglio? Puoi recuperarlo qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間違えて削除しても、ここから復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실수로 삭제했나요? 여기서 복구할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ongeluk iets verwijderd? Je kunt het hier herstellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagou algo sem querer? Você pode recuperar aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалили что-то случайно? Здесь можно восстановить запись."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanlışlıkla sildiğin kayıtları buradan geri yükleyebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不小心删错了？可以在这里恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不小心刪錯了？可以在這裡復原。"
          }
        }
      }
    },
