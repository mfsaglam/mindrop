    "Expired memories are deleted for good 7 days after they expire." : {
      "comment" : "Footer of the Expired section.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك استعادة العناصر خلال 7 أيام من انتهاء مدتها. بعدها تُحذف نهائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Ablauf hast du 7 Tage Zeit, deine Einträge wiederherzustellen. Danach werden sie endgültig gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can restore these memories for 7 days after they expire. After that, they’re permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes 7 días desde que caducan para recuperar tus entradas. Después se eliminan definitivamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez 7 jours après l’expiration pour récupérer vos entrées. Passé ce délai, elles sont définitivement supprimées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समय पूरा होने के बाद एंट्री वापस लाने के लिए आपके पास 7 दिन हैं। उसके बाद वे हमेशा के लिए हट जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai 7 giorni dalla scadenza per recuperare le voci. Poi verranno eliminate definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限が切れてから7日間は復元できます。その後は完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만료 후 7일 동안 복구할 수 있어요. 그 후에는 영구 삭제돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt items tot 7 dagen na het verlopen herstellen. Daarna worden ze definitief verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem 7 dias após o vencimento para recuperar suas entradas. Depois, elas são apagadas definitivamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи можно восстановить в течение 7 дней после окончания срока хранения. Затем они удаляются навсегда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süresi dolan kayıtları 7 gün içinde geri yükleyebilirsin. Ardından kalıcı olarak silinirler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条目到期后，你还有 7 天可以恢复。之后会永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目到期後，你還有 7 天可以復原。之後就會永久刪除。"
          }
        }
      }
    },
