    "Save a value under a keyword, then search that keyword in Spotlight to see it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ قيمة تحت كلمة مفتاحية، ثم ابحث عن تلك الكلمة في Spotlight لرؤيتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Wert unter einem Stichwort sichern und das Stichwort anschließend in Spotlight suchen, um den Wert zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda un valor con una palabra clave y luego busca esa palabra en Spotlight para verlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez une valeur sous un mot-clé, puis recherchez ce mot-clé dans Spotlight pour l’afficher."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी मान को कीवर्ड के साथ सेव करें, फिर उसे देखने के लिए Spotlight में वह कीवर्ड खोजें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva un valore con una parola chiave, poi cerca quella parola in Spotlight per vederlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値をキーワードで保存し、Spotlightでそのキーワードを検索すると値が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값을 키워드로 저장한 다음, Spotlight에서 해당 키워드를 검색하면 값이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
