    "Expired memories are deleted for good 7 days after they expire." : {
      "comment" : "Footer of the Expired section.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحذف الإدخالات المنتهية نهائيًا بعد 7 أيام من انتهاء صلاحيتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgelaufene Einträge werden 7 Tage nach Ablauf endgültig gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas caducadas se eliminan definitivamente 7 días después de caducar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrées expirées sont supprimées définitivement 7 jours après leur expiration."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समाप्त प्रविष्टियाँ समाप्ति के 7 दिन बाद स्थायी रूप से हट जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci scadute vengono eliminate definitivamente 7 giorni dopo la scadenza."
          }
        },
        "ja" : {
