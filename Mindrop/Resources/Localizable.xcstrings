        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las entradas de Eliminado recientemente se eliminarán en todos tus dispositivos. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les entrées des suppressions récentes seront supprimées sur tous vos appareils. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाल ही में डिलीट किए गए की हर प्रविष्टि आपके सभी डिवाइस से हटा दी जाएगी। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le voci in Eliminati di recente verranno eliminate su tutti i tuoi dispositivi. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最近削除した項目」のすべての項目が、すべてのデバイスから削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 삭제된 항목의 모든 항목이 모든 기기에서 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle items in Recent verwijderd worden op al je apparaten verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as entradas em Apagados Recentemente serão apagadas em todos os seus dispositivos. Esta ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все записи в «Недавно удаленных» будут удалены на всех ваших устройствах. Это действие нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son Silinenler’deki tüm kayıtlar tüm aygıtlarında silinecek. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“最近删除”中的所有条目都将在你的所有设备上删除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
