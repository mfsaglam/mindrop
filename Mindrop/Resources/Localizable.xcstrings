          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra os registros em seções por categoria. Desative para uma única lista, do mais recente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать записи по разделам категорий. Выключите, чтобы видеть один список, сначала новые."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtları kategoriye göre bölümlerde göster. Tek bir liste için kapatın; en yeniler önce gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
