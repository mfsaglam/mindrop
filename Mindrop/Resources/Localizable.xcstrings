    "This memory will be deleted on all your devices. This can’t be undone." : {
      "comment" : "Message of the alert confirming deletion for good.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف هذا العنصر نهائيًا من كل أجهزتك. لا يمكن التراجع عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Eintrag wird auf all deinen Geräten endgültig gelöscht. Das kannst du nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This memory will be permanently deleted from all your devices. You can’t undo this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta entrada se eliminará definitivamente de todos tus dispositivos. No podrás deshacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette entrée sera définitivement supprimée de tous vos appareils. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह एंट्री आपके सभी डिवाइस से हमेशा के लिए हट जाएगी। इसके बाद इसे वापस नहीं लाया जा सकेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa voce verrà eliminata definitivamente da tutti i tuoi dispositivi. Non potrai annullare l’operazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この項目をすべてのデバイスから完全に削除します。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목을 모든 기기에서 영구 삭제해요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit item wordt definitief van al je apparaten verwijderd. Dit kun je niet ongedaan maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta entrada será apagada definitivamente de todos os seus dispositivos. Não será possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта запись будет навсегда удалена со всех ваших устройств. Отменить это действие нельзя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kayıt tüm cihazlarından kalıcı olarak silinecek. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这条内容将从你的所有设备上永久删除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這筆內容會從你的所有裝置上永久刪除。此操作無法復原。"
          }
        }
      }
    },
    "Try closing Mindrop and opening it again." : {
