      "comment" : "Onboarding headline: information the user wants to remember is close at hand. Warm and personal; this refers to saved practical details, not sentimental memories. Pair with the short save-and-find subtitle.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ما تريد تذكّره في متناول يدك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du dir merken möchtest, immer griffbereit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you want to remember, within reach"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que quieres recordar, siempre a mano"
