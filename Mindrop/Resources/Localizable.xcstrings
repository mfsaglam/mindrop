    "Memories are deleted for good 30 days after you delete them, on all your devices." : {
      "comment" : "Footer of Recently Deleted.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحذف الذكريات نهائيًا بعد 30 يومًا من حذفها، على جميع أجهزتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge werden 30 Tage nach dem Löschen endgültig gelöscht, auf allen deinen Geräten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las memorias se eliminan definitivamente 30 días después de borrarlas, en todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mémos sont supprimés définitivement 30 jours après leur suppression, sur tous vos appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिलीट करने के 30 दिन बाद यादें आपके सभी डिवाइस से हमेशा के लिए डिलीट हो जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I ricordi vengono eliminati definitivamente 30 giorni dopo, su tutti i tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除したメモは、30日後にすべてのデバイスから完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제한 메모는 30일 후 모든 기기에서 영구적으로 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
