    "This memory will be deleted on all your devices. This can’t be undone." : {
      "comment" : "Message of the alert confirming deletion for good.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف هذا السجل من جميع أجهزتك. لا يمكن التراجع عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Eintrag wird auf allen deinen Geräten gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta memoria se eliminará en todos tus dispositivos. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mémo sera supprimé sur tous vos appareils. Cette action est irréversible."
          }
