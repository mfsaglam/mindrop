          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメモはすべてのデバイスから削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 메모가 모든 기기에서 삭제됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
