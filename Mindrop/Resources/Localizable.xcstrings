    "A deleted memory waits here, so a mistake can be undone." : {
      "comment" : "Under the title of the empty Recently Deleted.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتظر الإدخال المحذوف هنا، حتى يمكن التراجع عن الخطأ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gelöschter Eintrag wartet hier, damit sich ein Versehen rückgängig machen lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una entrada eliminada espera aquí, para que puedas deshacer un error."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une entrée supprimée attend ici, pour qu’une erreur puisse être annulée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाई गई प्रविष्टि यहाँ रहती है, ताकि गलती सुधारी जा सके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una voce eliminata resta qui, così puoi rimediare a un errore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除した項目はここに残るので、間違いを取り消せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제한 항목은 여기에 남아 있어 실수를 되돌릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een verwijderd item wacht hier, zodat je een vergissing kunt herstellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma entrada apagada fica aqui, para que um erro possa ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённая запись ждёт здесь, чтобы ошибку можно было исправить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silinen bir kayıt burada bekler, böylece bir hata geri alınabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除的条目会保留在这里，以便撤销误操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已刪除的項目會保留在這裡，以便還原誤刪。"
          }
        }
      }
    },
