    "It will be removed from Spotlight and kept in Recently Deleted for 30 days." : {
      "comment" : "Message of the alert confirming that a memory is deleted.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالته من Spotlight والاحتفاظ به في «المحذوفة مؤخرًا» لمدة 30 يومًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird aus Spotlight entfernt und 30 Tage lang in „Zuletzt gelöscht“ aufbewahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitará de Spotlight y se guardará en Eliminado recientemente durante 30 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sera retiré de Spotlight et conservé 30 jours dans Suppressions récentes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे Spotlight से हटा दिया जाएगा और 30 दिनों तक “हाल ही में डिलीट किए गए” में रखा जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà rimosso da Spotlight e conservato in Eliminati di recente per 30 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlightから削除され、「最近削除した項目」に30日間保管されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight에서 제거되고 30일 동안 최근 삭제된 항목에 보관됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wordt uit Spotlight verwijderd en 30 dagen bewaard in Recent verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Será removido do Spotlight e mantido em Apagados Recentemente por 30 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись будет удалена из Spotlight и сохранится в «Недавно удаленных» на 30 дней."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight’tan kaldırılır ve 30 gün boyunca Son Silinenler’de tutulur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会从 Spotlight 中移除，并在“最近删除”中保留 30 天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它會從 Spotlight 中移除，並在「最近刪除」中保留 30 天。"
          }
        }
      }
    },
