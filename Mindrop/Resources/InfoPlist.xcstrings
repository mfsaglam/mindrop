    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Mindrop بصمة الوجه لإظهار القيم التي حددتها كحساسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop verwendet Face ID, um die Werte zu zeigen, die du als vertraulich markiert hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mindrop uses Face ID to show the values you marked as sensitive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop usa Face ID para mostrar los valores que marcaste como confidenciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop utilise Face ID pour afficher les valeurs que vous avez marquées comme confidentielles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop आपके द्वारा संवेदनशील चिह्नित मान दिखाने के लिए Face ID का उपयोग करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop usa Face ID per mostrare i valori che hai contrassegnato come riservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindropは、機密に設定した値を表示するためにFace IDを使用します。"
