        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop은 민감한 정보로 표시한 값을 보여 주기 위해 Face ID를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop gebruikt Face ID om de waarden te tonen die je als gevoelig hebt gemarkeerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
