    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم بصمة الوجه لفتح قفل المعلومات الحساسة التي حفظتها في Mindrop."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Face ID entsperrst du die vertraulichen Inhalte, die du in Mindrop gesichert hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID to unlock the sensitive details you’ve saved in Mindrop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Face ID para desbloquear los datos confidenciales que has guardado en Mindrop."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID permet de déverrouiller les informations confidentielles que vous avez enregistrées dans Mindrop."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop में सेव की गई संवेदनशील जानकारी अनलॉक करने के लिए Face ID का इस्तेमाल होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Face ID per sbloccare le informazioni riservate che hai salvato in Mindrop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindropで非公開にした情報のロックをFace IDで解除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop에 저장한 민감한 정보의 잠금을 Face ID로 해제해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik Face ID om de gevoelige informatie die je in Mindrop bewaart te ontgrendelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o Face ID para desbloquear as informações confidenciais que você salvou no Mindrop."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID открывает доступ к конфиденциальной информации, сохранённой в Mindrop."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop’ta hassas olarak işaretlediğin bilgileri görmek için Face ID kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用面容 ID 解锁你在 Mindrop 中保存的敏感信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Face ID 解鎖你在 Mindrop 中儲存的敏感資訊。"
          }
        }
      }
    }
