          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop 使用相机将文本和二维码扫描到条目中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop 會使用相機將文字和 QR 碼掃描到項目中。"
