    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Mindrop الكاميرا لمسح النصوص ورموز QR وحفظها في عنصر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Kamera kannst du Text und QR-Codes in Mindrop einlesen und als Eintrag sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your camera to scan text or QR codes and save them in a memory in Mindrop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop usa la cámara para escanear texto o códigos QR y guardarlos en una entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop utilise l’appareil photo pour scanner du texte ou des codes QR et les enregistrer dans une entrée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop कैमरे से टेक्स्ट या QR कोड स्कैन करके उन्हें एंट्री में सेव करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop usa la fotocamera per scansionare testo e codici QR e salvarli in una voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindropでは、カメラでテキストやQRコードを読み取り、項目として保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop은 카메라로 텍스트나 QR 코드를 스캔해 항목으로 저장할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de camera kun je tekst en QR-codes scannen en als item in Mindrop bewaren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mindrop usa a câmera para ler textos e códigos QR e salvá-los em uma entrada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С помощью камеры Mindrop можно отсканировать текст или QR-код и сохранить его в записи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop, metinleri ve QR kodlarını kamerayla tarayıp kayıt olarak saklamanı sağlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop 使用相机扫描文本或二维码，并将内容保存为条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop 會使用相機掃描文字或 QR 碼，並將內容儲存為項目。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم بصمة الوجه لفتح قفل المعلومات الحساسة التي حفظتها في Mindrop."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Face ID entsperrst du die vertraulichen Inhalte, die du in Mindrop gesichert hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID to unlock the sensitive details you’ve saved in Mindrop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Face ID para desbloquear los datos confidenciales que has guardado en Mindrop."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID permet de déverrouiller les informations confidentielles que vous avez enregistrées dans Mindrop."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop में सेव की गई संवेदनशील जानकारी अनलॉक करने के लिए Face ID का इस्तेमाल होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Face ID per sbloccare le informazioni riservate che hai salvato in Mindrop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindropで非公開にした情報のロックをFace IDで解除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop에 저장한 민감한 정보의 잠금을 Face ID로 해제해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik Face ID om de gevoelige informatie die je in Mindrop bewaart te ontgrendelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o Face ID para desbloquear as informações confidenciais que você salvou no Mindrop."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID открывает доступ к конфиденциальной информации, сохранённой в Mindrop."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindrop’ta hassas olarak işaretlediğin bilgileri görmek için Face ID kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用面容 ID 解锁你在 Mindrop 中保存的敏感信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Face ID 解鎖你在 Mindrop 中儲存的敏感資訊。"
          }
        }
      }
    }
  },
  "version" : "1.0"
