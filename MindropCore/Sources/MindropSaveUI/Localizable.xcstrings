    "Shows in Spotlight as “%@”, where anyone using this iPhone may see it.": {
      "comment": "Under Sensitive and Keep. %@ is the line Spotlight will show, the details then the keyword, as the user typed them.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر في Spotlight هكذا: «%@»، وقد يراه أي شخص يستخدم هذا الـ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint in Spotlight als „%@“ – alle, die dieses iPhone benutzen, können es sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows in Spotlight as “%@”, where anyone using this iPhone may see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en Spotlight como «%@», donde cualquiera que use este iPhone puede verlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaît dans Spotlight comme « %@ », où toute personne utilisant cet iPhone peut le voir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight में “%@” के रूप में दिखेगा, जहाँ इस iPhone का इस्तेमाल करने वाला कोई भी इसे देख सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appare in Spotlight come “%@”, dove chiunque usi questo iPhone può vederlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlightには「%@」と表示され、このiPhoneを使う人なら誰でも見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight에 “%@”(으)로 표시되며, 이 iPhone을 사용하는 누구나 볼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschijnt in Spotlight als ‘%@’, waar iedereen die deze iPhone gebruikt het kan zien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece no Spotlight como “%@”, onde qualquer pessoa que use este iPhone pode ver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается в Spotlight как «%@» — его может увидеть любой, кто пользуется этим iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight’ta “%@” olarak görünür; bu iPhone’u kullanan herkes görebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“聚焦”中显示为“%@”，任何使用这台 iPhone 的人都可能看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「Spotlight」中顯示為「%@」，任何使用這部 iPhone 的人都可能看到。"
          }
        }
      }
    },
    "Spotlight shows only the keyword, and Mindrop hides the value until you unlock it.": {
      "comment": "Footer under the Sensitive switch when it is on.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الكلمة المفتاحية فقط في Spotlight. يبقى المحتوى مخفيًا في Mindrop حتى تفتح قفله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Spotlight erscheint nur das Stichwort. Der gespeicherte Inhalt bleibt in Mindrop verborgen, bis du ihn entsperrst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the keyword appears in Spotlight. Your saved details stay hidden in Mindrop until you unlock them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Spotlight solo aparece la palabra clave. El contenido queda oculto en Mindrop hasta que lo desbloquees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le mot-clé apparaît dans Spotlight. Le contenu reste masqué dans Mindrop jusqu’à ce que vous le déverrouilliez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight में सिर्फ़ कीवर्ड दिखता है। सेव की गई जानकारी Mindrop में तब तक छिपी रहती है, जब तक आप उसे अनलॉक नहीं करते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Spotlight compare solo la parola chiave. Il contenuto resta nascosto in Mindrop finché non lo sblocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlightに表示されるのはキーワードだけです。内容はロックを解除するまでMindropで非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight에는 키워드만 보여요. 저장한 내용은 잠금을 해제할 때까지 Mindrop에서 숨겨져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het trefwoord verschijnt in Spotlight. De inhoud blijft verborgen in Mindrop totdat je die ontgrendelt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a palavra-chave aparece no Spotlight. O conteúdo fica oculto no Mindrop até você desbloqueá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Spotlight видно только ключевое слово. Содержимое скрыто в Mindrop, пока вы не разблокируете доступ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight’ta yalnızca anahtar kelime görünür. Kaydettiğin bilgi, kilidi açana kadar Mindrop’ta gizli kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“聚焦”中只显示关键词。保存的内容会在 Mindrop 中保持隐藏，直到你解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight 中只顯示關鍵字。儲存的內容會在 Mindrop 中保持隱藏，直到你解鎖。"
          }
        }
      }
    },
    "Tap the lines to put in the details.": {
      "comment": "Footer under the lines read from a shared image; tapping a line adds it to the details, tapping again removes it.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الأسطر لإضافتها إلى التفاصيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Zeilen, die in die Details sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the lines to put in the details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca las líneas que quieras poner en los detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez les lignes à placer dans les détails."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विवरण में डालने के लिए पंक्तियों पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca le righe da inserire nei dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細に入れる行をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세부 사항에 넣을 줄을 탭하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de regels die in de details moeten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nas linhas para colocá-las nos detalhes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь строк, которые нужно добавить в сведения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
