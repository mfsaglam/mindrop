    "Saved values can show up directly in Spotlight search results, where anyone using this iPhone may see them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تظهر المعلومات التي تحفظها في نتائج بحث Spotlight. ويمكن لأي شخص يستخدم هذا الـ iPhone رؤيتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du sicherst, kann in den Spotlight-Suchergebnissen erscheinen. Alle, die dieses iPhone benutzen, könnten es sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you save may appear in Spotlight search results. Anyone using this iPhone could see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que guardas puede aparecer en los resultados de Spotlight. Cualquier persona que use este iPhone podría verlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous enregistrez peut apparaître dans les résultats de Spotlight. Toute personne utilisant cet iPhone pourrait le voir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव की गई जानकारी Spotlight के खोज नतीजों में दिख सकती है। इस iPhone का इस्तेमाल करने वाला कोई भी व्यक्ति उसे देख सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che salvi può comparire nei risultati di Spotlight. Chiunque usi questo iPhone potrebbe vederlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した内容がSpotlightの検索結果に表示されることがあります。このiPhoneを使う人なら誰でも見られる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 내용이 Spotlight 검색 결과에 나타날 수 있어요. 이 iPhone을 사용하는 사람은 누구나 볼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je bewaart, kan in de zoekresultaten van Spotlight verschijnen. Iedereen die deze iPhone gebruikt, zou het kunnen zien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você salva pode aparecer nos resultados do Spotlight. Qualquer pessoa que use este iPhone pode ver essas informações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённая информация может появиться в результатах поиска Spotlight. Её может увидеть любой, кто пользуется этим iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğin bilgiler Spotlight arama sonuçlarında görünebilir. Bu iPhone’u kullanan herkes bu bilgileri görebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的内容可能出现在“聚焦”搜索结果中。任何使用这台 iPhone 的人都可能看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的內容可能出現在 Spotlight 搜尋結果中。任何使用這部 iPhone 的人都可能看到。"
          }
        }
      }
    },
