    "Saved values can show up directly in Spotlight search results, where anyone using this iPhone may see them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تظهر القيم المحفوظة مباشرةً في نتائج بحث Spotlight، حيث يمكن لأي شخص يستخدم هذا الـ iPhone رؤيتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesicherte Werte können direkt in den Spotlight-Suchergebnissen erscheinen, wo sie für alle sichtbar sind, die dieses iPhone benutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores guardados pueden aparecer directamente en los resultados de Spotlight, donde cualquiera que use este iPhone podría verlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs enregistrées peuvent apparaître directement dans les résultats de Spotlight, où toute personne utilisant cet iPhone peut les voir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव किए गए मान सीधे Spotlight खोज परिणामों में दिख सकते हैं, जहाँ इस iPhone का उपयोग करने वाला कोई भी उन्हें देख सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori salvati possono comparire direttamente nei risultati di Spotlight, dove chiunque usi questo iPhone può vederli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した値はSpotlightの検索結果に直接表示されることがあり、このiPhoneを使う人なら誰でも見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 값은 Spotlight 검색 결과에 그대로 표시될 수 있으며, 이 iPhone을 사용하는 사람은 누구나 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaarde waarden kunnen rechtstreeks in Spotlight-zoekresultaten verschijnen, waar iedereen die deze iPhone gebruikt ze kan zien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores salvos podem aparecer diretamente nos resultados do Spotlight, onde qualquer pessoa que use este iPhone pode vê-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые значения могут отображаться прямо в результатах Spotlight, где их увидит любой, кто пользуется этим iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen değerler doğrudan Spotlight arama sonuçlarında görünebilir; bu iPhone’u kullanan herkes onları görebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储的值可能直接出现在 Spotlight 搜索结果中，使用这台 iPhone 的任何人都可能看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的值可能直接出現在 Spotlight 搜尋結果中，使用這台 iPhone 的任何人都可能看到。"
          }
        }
      }
    },
