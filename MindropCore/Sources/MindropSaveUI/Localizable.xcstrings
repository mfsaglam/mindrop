    "Leaves Spotlight when it expires. You can still recover it in Mindrop for 7 days.": {
      "comment": "Footer under the Keep picker when the memory is temporary.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختفي من Spotlight عند انتهاء صلاحيته. ويمكنك استعادته في Mindrop خلال 7 أيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschwindet nach Ablauf aus Spotlight. In Mindrop lässt es sich noch 7 Tage lang wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desaparece de Spotlight al caducar. Puedes recuperarla en Mindrop durante 7 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disparaît de Spotlight à expiration. Vous pouvez encore la récupérer dans Mindrop pendant 7 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय समाप्त होने पर Spotlight से हट जाता है। आप इसे 7 दिनों तक Mindrop में वापस ला सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scompare da Spotlight alla scadenza. Puoi ancora recuperarla in Mindrop per 7 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限が来るとSpotlightに表示されなくなります。7日間はMindropで復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료되면 Spotlight에서 사라집니다. 7일 동안은 Mindrop에서 복구할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdwijnt uit Spotlight als het verloopt. Je kunt het nog 7 dagen in Mindrop herstellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai do Spotlight quando expira. Você ainda pode recuperá-la no Mindrop por 7 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исчезает из Spotlight по истечении срока. Ещё 7 дней её можно восстановить в Mindrop."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süresi dolunca Spotlight’tan kalkar. 7 gün boyunca Mindrop’ta geri yükleyebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到期后会从“聚焦”中移除。7 天内仍可在 Mindrop 中恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到期後會從 Spotlight 移除。7 天內仍可在 Mindrop 中復原。"
          }
        }
      }
    },
