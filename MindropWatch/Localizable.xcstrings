    "Your iPhone files it and adds it to Spotlight." : {
      "comment" : "Apple Watch: under Save, what happens to a memory saved on the watch.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصنّفه iPhone ويضيفه إلى Spotlight."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iPhone ordnet ihn ein und fügt ihn zu Spotlight hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu iPhone la clasifica y la añade a Spotlight."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre iPhone la classe et l’ajoute à Spotlight."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका iPhone इसे व्यवस्थित करके Spotlight में जोड़ता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iPhone la classifica e la aggiunge a Spotlight."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneが分類してSpotlightに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone이 분류하여 Spotlight에 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je iPhone ordent het en zet het in Spotlight."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu iPhone a organiza e adiciona ao Spotlight."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone распределит запись и добавит её в Spotlight."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’un onu sınıflandırıp Spotlight’a ekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 会将其归类并添加到“聚焦”。"
